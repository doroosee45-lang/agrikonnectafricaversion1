{
  "expo": {
    "name": "AgriKonnect Africa",
    "slug": "omedev",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "agrikonnect",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F7F2",
    "primaryColor": "#174D35",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agrikonnect.africa",
      "infoPlist": {
        "NSCameraUsageDescription": "AgriKonnect utilise la caméra pour photographier vos parcelles et vos lots (traçabilité).",
        "NSPhotoLibraryUsageDescription": "AgriKonnect accède à vos photos pour joindre des preuves aux lots et aux diagnostics.",
        "NSLocationWhenInUseUsageDescription": "La localisation sert à délimiter vos parcelles et à afficher les marchés proches."
      }
    },
    "android": {
      "package": "com.agrikonnect.africa",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "AgriKonnect utilise le micro pour enregistrer les notes vocales que vous envoyez."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AgriKonnect accède à vos photos pour les partager dans vos discussions.",
          "cameraPermission": "AgriKonnect utilise la caméra pour photographier un problème sur le terrain et l'envoyer."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La localisation sert à partager votre position et à délimiter vos parcelles."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:4000/api/v1",
      "realtimeUrl": "http://localhost:4000",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d5509c7c-8489-4b60-95b1-33daf6625587"
      }
    },
    "owner": "omedevs-team"
  }
}
