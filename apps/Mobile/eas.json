{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PUSH": "true",
        "EXPO_PUBLIC_NATIVE_CALLS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_PUSH": "true",
        "EXPO_PUBLIC_NATIVE_CALLS": "true"
      }
    },
    "production": {
      "environment": "production"
    }
  }
}
