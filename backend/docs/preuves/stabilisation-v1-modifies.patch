+  assert.notEqual(w1.body.data.farm.id, w2.body.data.farm.id);
+});
diff --git a/backend/tests/e2e/revueContradictoireV1.e2e.test.mjs b/backend/tests/e2e/revueContradictoireV1.e2e.test.mjs
